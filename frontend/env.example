# Database Connection
DATABASE_URL="postgresql://user:password@host:port/database_name?sslmode=require"

# Backend API base URL
# Use the deployed Render backend URL in production, and keep the local URL for development.
BACKEND_URL="http://localhost:5000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# NextAuth Secret
# You can generate a new one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
